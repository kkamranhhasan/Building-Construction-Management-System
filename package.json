{
  "name": "construction-company-management-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "cd backend && npm run dev",
    "dev:web": "cd web && npm run dev",
    "dev:admin": "cd admin-dashboard && npm run dev",
    "kill:ports": "kill -9 $(lsof -ti:3000,5000,5001,5002,5173 2>/dev/null) 2>/dev/null || echo 'No ports were occupied.'",
    "clean": "rm -rf web/.next admin-dashboard/dist"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
